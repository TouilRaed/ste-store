# Supabase — Project Settings > API in the Supabase dashboard.
# Without these the storefront runs on the bundled demo catalogue.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS so the confirmation page can read an order back.
# Never expose this to the browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (web /admin + the Expo app). Pick a long random secret.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_JWT_SECRET=generate-with-openssl-rand-base64-32

# Intigo delivery (API v3). Only the key is required — the base URL defaults
# to https://api.intigo.net/api/v3. Without a key the "Prêt à expédier" button
# reports that shipping is unconfigured rather than failing silently.
INTIGO_API_KEY=your-intigo-api-key
# INTIGO_API_URL=https://api.intigo.net/api/v3
