# Supabase — Project Settings > API in the Supabase dashboard.
# Without these the storefront runs on the bundled demo catalogue.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS so the confirmation page can read an order back.
# Never expose this to the browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (web /admin + the Expo app). Pick a long random secret.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_JWT_SECRET=generate-with-openssl-rand-base64-32
